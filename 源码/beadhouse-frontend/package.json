{
  "name": "geracomium-admin-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run lint:check && vite build && npm run check:bundle",
    "test:recharge": "node --test scripts/recharge-contract.test.cjs",
    "test:resources": "node --test scripts/auth-resource-contract.test.cjs",
    "test:bed": "node --test scripts/bed-contract.test.cjs",
    "test:notifications": "node --test scripts/alert-notification-contract.test.cjs",
    "test:ui-recovery": "node --test scripts/ui-recovery-contract.test.cjs",
    "lint": "eslint src --fix",
    "prettier": "prettier --write .",
    "typecheck": "vue-tsc --noEmit",
    "test:build-compat": "node --test scripts/build-compat-contract.test.cjs",
    "test:dependency-security": "node --test scripts/dependency-security-contract.test.cjs",
    "audit:dependencies": "npm audit --audit-level=low && npm audit --omit=dev --audit-level=low",
    "lint:check": "eslint src --max-warnings=0",
    "test:charts": "node --test scripts/chart-loading-contract.test.cjs",
    "test:request-failure": "node --test scripts/request-failure-contract.test.cjs",
    "test:styles": "node --test scripts/style-module-contract.test.cjs",
    "test:bundle-budget": "node --test scripts/bundle-budget-contract.test.cjs",
    "check:bundle": "node scripts/bundle-budget.cjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@icon-park/vue-next": "^1.4.2",
    "axios": "1.20.0",
    "echarts": "6.1.0",
    "element-plus": "2.14.7",
    "vue": "3.5.44",
    "vue-router": "^4.0.3",
    "vuex": "^4.0.0",
    "vuex-persistedstate": "^4.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vue/compiler-sfc": "3.5.44",
    "cz-customizable": "7.5.4",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "^16.4.0",
    "husky": "^8.0.2",
    "postcss": "8.5.31",
    "prettier": "^2.4.1",
    "sass": "1.106.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    }
  },
  "lint-staged": {
    "src/**/*.{js,vue}": [
      "eslint --fix",
      "git add"
    ]
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "external-editor": {
      "tmp": "0.2.7"
    },
    "brace-expansion@<1.1.21": "1.1.21",
    "picomatch@<2.3.2": "2.3.2"
  }
}
