<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shanzhu.beadhouse.dao.mapper.AiAuditLogMapper">
    <select id="countAuditLogs" resultType="java.lang.Long">
        SELECT COUNT(*) FROM ai_audit_log
    </select>
    <select id="listAuditLogs" resultType="com.shanzhu.beadhouse.entity.vo.AiAuditLogVo">
        SELECT id, module, action, object_type, object_id, operator_name, detail, create_time
        FROM ai_audit_log
        ORDER BY create_time DESC, id DESC
        LIMIT #{offset}, #{pageSize}
    </select>
</mapper>
