<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shanzhu.beadhouse.dao.mapper.LabelMapper">
    <select id="listElderLabelById" resultType="com.shanzhu.beadhouse.entity.vo.GetElderLabelByIdLabelVo">
        SELECT id,
               `name`,
               color
        FROM label
        WHERE id IN (
            SELECT label_id
            FROM elder_label
            WHERE elder_id = #{elderId})
    </select>
</mapper>
