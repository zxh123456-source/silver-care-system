COMPOSE_PROJECT_NAME=silver-care-system
MYSQL_PORT=3308
REDIS_PORT=6379
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091
RAG_PORT=8001
BACKEND_PORT=9001
FRONTEND_PORT=8080
MYSQL_ROOT_PASSWORD=
DB_USERNAME=root
DB_PASSWORD=
DB_URL=jdbc:mysql://127.0.0.1:3308/db_beadhouse?useSSL=false&useUnicode=true&characterEncoding=utf-8&allowMultiQueries=true&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
# New uploaded resources use the same frontend API proxy by default.
FILE_UPLOAD_HEAD=/api
REDIS_PASSWORD=
JWT_SECRET=
AI_RAG_INTERNAL_TOKEN=
# RAG_INTERNAL_TOKEN must match AI_RAG_INTERNAL_TOKEN; startup derives it when empty.
RAG_INTERNAL_TOKEN=
MINIO_ROOT_USER=silvercare
MINIO_ROOT_PASSWORD=
MILVUS_ROOT_PASSWORD=
RAG_MILVUS_TOKEN=
# Optional: required only for importing accounts using legacy AES passwords.
LEGACY_AES_IV=
LEGACY_AES_KEY=
PASSWORD_RESET_EMAIL_ENABLED=false
AI_ALERT_SCAN_ENABLED=true
AI_ALERT_SCAN_BATCH_SIZE=100
AI_ALERT_SCAN_MAX_BATCHES=4
AI_ALERT_SCAN_LEASE_SECONDS=120
AI_ALERT_SCAN_RESCAN_SECONDS=900
AI_ALERT_SCAN_INITIAL_DELAY_MS=10000
AI_ALERT_SCAN_DELAY_MS=60000
MAIL_HOST=smtp.example.com
MAIL_ADDRESS=
MAIL_PASSWORD=
